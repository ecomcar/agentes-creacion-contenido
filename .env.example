# ── Única clave obligatoria ──────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── Topes de gasto (se comprueban ANTES de cada llamada) ─────────────
# Peor caso = tokens de entrada reales + max_tokens de salida completos.
MAX_COST_PER_CALL_USD=0.50
MAX_COST_PER_PROJECT_USD=5.00
MAX_COST_PER_SESSION_USD=25.00

# ── Precios por millón de tokens: "entrada,salida" ───────────────────
# Sólo sonnet-5 viene verificado. Confirmar los demás contra la
# documentación oficial antes de confiar en las estimaciones de coste.
# PRICE_CLAUDE_SONNET_5=2.00,10.00
# PRICE_CLAUDE_OPUS_5=15.00,75.00
# PRICE_CLAUDE_HAIKU_4_5=1.00,5.00

# ── Depuración ───────────────────────────────────────────────────────
# Fija un modelo para todas las llamadas, ignorando el Router.
# FORCE_MODEL=claude-haiku-4-5

# ── Fases posteriores (aún no conectadas) ────────────────────────────
# NANO_BANANA_API_KEY=
# KLING_API_KEY=
# VOICE_API_KEY=
# DATABASE_URL=postgresql://user:pass@localhost:5432/ugc
# STORAGE_BUCKET=

# ── Topes de reintento por etapa (orquestador) ───────────────────────
# Distinto del bucle de reparación del gateway: aquí el artefacto es
# válido pero no supera los criterios, o el humano lo rechazó.
MAX_RETRY_STRATEGY=2
MAX_RETRY_HOOKS=2
MAX_RETRY_SCRIPT=2
MAX_RETRY_STORYBOARD=2
MAX_RETRY_IMAGE=3
MAX_RETRY_VIDEO=3
MAX_AUDIT_CYCLES=3

# ── Precios de imagen por generación ─────────────────────────────────
# NINGUNO viene verificado. Configurar con las cifras reales del
# proveedor antes de presupuestar una campaña.
# PRICE_IMAGE_NANO_BANANA=0.02
# PRICE_IMAGE_NANO_BANANA_PRO=0.04

# ── Topes de generación de imagen ────────────────────────────────────
MAX_IMAGE_COST_PER_CLIP_USD=1.00
MAX_IMAGE_COST_PER_PROJECT_USD=10.00

# ── Precios de video por segundo ─────────────────────────────────────
# NINGUNO viene verificado. El video se cobra por segundo generado.
# PRICE_VIDEO_KLING=0.03
# PRICE_VIDEO_KLING_3=0.05

# ── Topes de generación de video ─────────────────────────────────────
MAX_VIDEO_COST_PER_CLIP_USD=2.00
MAX_VIDEO_COST_PER_PROJECT_USD=20.00
MAX_POLLS_PER_JOB=120

# ── Precios de voz por cada 1.000 caracteres ─────────────────────────
# PRICE_VOICE_ELEVENLABS=0.30

# ── Memoria creativa ─────────────────────────────────────────────────
# Días tras los que un aprendizaje deja de influir en campañas nuevas.
CREATIVE_MEMORY_TTL_DAYS=180

# ── fal.ai (imagen: Nano Banana Pro) ─────────────────────────────────
# Clave en https://fal.ai/dashboard/keys
FAL_KEY=
# model_id exacto — confirmar en https://fal.ai/models antes de producción
# FAL_MODEL_ID_IMAGE=fal-ai/nano-banana/pro
# PRICE_IMAGE_FAL_NANO_BANANA_PRO=0.04